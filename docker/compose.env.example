# Set the published image with a version or digest before starting Compose.
LSKY_IMAGE=
LSKY_LISTEN_ADDRESS=127.0.0.1
LSKY_PORT=8080
APP_URL=https://images.example.com
APP_KEY=
SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=172.30.0.1
# TRUSTED_HOSTS=images.example.com

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/lsky.sqlite
# For MySQL or PostgreSQL set all of the following and change DB_CONNECTION.
# DB_HOST=db.example.internal
# DB_PORT=3306
# DB_DATABASE=lsky
# DB_USERNAME=lsky
# DB_PASSWORD=
