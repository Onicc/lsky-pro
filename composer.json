{
    "name": "onicc/lsky-pro",
    "type": "project",
    "description": "Lsky Pro image hosting and photo management.",
    "keywords": [
        "images",
        "image-hosting",
        "laravel"
    ],
    "license": "GPL-3.0-only",
    "require": {
        "php": "~8.5.0",
        "alibabacloud/green": "^1.8",
        "guzzlehttp/guzzle": "^7.10",
        "intervention/image": "^4.0",
        "laravel/framework": "^13.43",
        "laravel/sanctum": "^4.0",
        "league/commonmark": "^2.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-ftp": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "league/flysystem-webdav": "^3.0",
        "overtrue/flysystem-cos": "^5.0",
        "overtrue/flysystem-qiniu": "^3.0",
        "tencentcloud/ims": "^3.0",
        "wispx/flysystem-upyun": "^1.0",
        "zing/flysystem-oss": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
